# Copy this file to .env and fill in real values.
# Never commit the real .env file — it is already excluded via .gitignore.

# Shopify app credentials, from the Partner Dashboard (or auto-filled by `shopify app init` / `npm run config:link`)
SHOPIFY_API_KEY=your_app_client_id_here
SHOPIFY_API_SECRET=your_app_client_secret_here

# Comma-separated Admin API scopes this app requests
SCOPES=write_products,write_metaobjects,write_metaobject_definitions

# Public URL of the running app. In local development, `npm run dev` (Shopify CLI)
# updates this automatically to the current tunnel URL — you usually don't set this by hand.
SHOPIFY_APP_URL=https://example.com

# Prisma database connection string. Defaults to a local SQLite file for development.
DATABASE_URL="file:dev.sqlite"
